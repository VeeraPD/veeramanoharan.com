---
import { site } from '../config/site';
---

<section id="contact" class="grid justify-items-start gap-8 border-t border-line py-20 md:py-24">
  <h2 class="max-w-[18ch] text-[clamp(2rem,4.6vw,3.4rem)] leading-[1.08] font-bold tracking-tight text-balance">
    Building AI products for real users? Let's talk.
  </h2>
  <div class="flex flex-wrap gap-3">
    <a class="btn btn-primary" href={`mailto:${site.email}`} data-track="email-click">{site.email}</a>
    <a class="btn" href={site.linkedin} rel="noopener" data-track="linkedin-click">LinkedIn</a>
  </div>
  <div id="resumes" class="flex flex-wrap gap-x-7 gap-y-3 text-[0.95rem]">
    <a
      class="link-underline"
      href={site.resumes.b2b.file}
      download
      data-track="resume-download"
      data-track-label="b2b">{site.resumes.b2b.label} (PDF)</a
    >
    <a
      class="link-underline"
      href={site.resumes.devices.file}
      download
      data-track="resume-download"
      data-track-label="devices">{site.resumes.devices.label} (PDF)</a
    >
  </div>
</section>

<footer class="flex flex-wrap justify-between gap-3 border-t border-line pt-6 pb-12 font-mono text-xs text-muted">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <span>Built with Astro</span>
</footer>
